{
	"name": "@betterdiscord.com/injection",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"get": "bun scripts/preload.ts",
		"test:stable": "bun test ../../tests/injection.test.ts -- --channel stable",
		"test:canary": "bun test ../../tests/injection.test.ts -- --channel canary",
		"test:ptb": "bun test ../../tests/injection.test.ts -- --channel ptb",
		"test:development": "bun test ../../tests/injection.test.ts -- --channel development",
		"lint": "bun oxlint --fix",
		"fmt": "bun oxfmt",
		"dist": "bun dts && bun build --target node --production src/index.ts --outfile=./dist/index.js -e '@electron/asar'",
		"dts": "bun tsgo --declaration --emitDeclarationOnly --outDir ./dist"
	},
	"dependencies": {
		"@electron/asar": "^3.2.0"
	}
}
