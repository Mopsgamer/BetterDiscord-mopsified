{
	"name": "@betterdiscord.com/core",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun dts && bun build --target node --production src/index.ts --outfile=./dist/index.js",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/find": "workspace:*"
	}
}
