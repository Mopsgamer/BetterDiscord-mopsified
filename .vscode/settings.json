{
    // General file formatting
    "files.eol": "\n",
    "files.encoding": "utf8",
    "files.trimTrailingWhitespace": true,
    // Editor settings
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "never"
    },
    "eslint.enable": false,
    "search.smartCase": true,
    // JavaScript / TypeScript
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "js/ts.format.semicolons": "insert",
    "js/ts.preferences.quoteStyle": "double",
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
    "js/ts.preferences.autoImportFileExcludePatterns": [
        "src/betterdiscord/api/*"
    ],
    // Extensions
    // VsCode Action Buttons
    "actionButtons": {
        "defaultColor": "statusBar.foreground",
        "loadNpmCommands": false,
        "reloadButton": null, // null = auto reload
        "commands": [
            {
                "name": "$(tools) Build",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Build"
                ]
            },
            {
                "name": "$(eye) Watch",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Watch"
                ]
            },
            {
                "name": "$(beaker) Test",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Test"
                ]
            },
            {
                "name": "$(list-tree) Todos",
                "useVsCodeApi": true,
                "command": "todo-tree-view.focus"
            },
        ]
    }
}