{
  "name": "betterdiscord-rewrite",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "installer"
  ],
  "scripts": {
    "lint": "oxlint .",
    "format": "oxlint . --fix",
    "build:extension": "bun build ./extension/index.ts --outdir ./extension/dist --target browser",
    "typecheck": "tsgo"
  },
  "devDependencies": {
    "oxc": "latest",
    "@typescript/native-preview": "latest"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
