{
	"name": "@betterdiscord.com/components",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
