{
	"name": "@betterdiscord.com/bd-injection",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"cli": "bun --bun ../../packages/cli/dist/main.js",
		"get": "bun scripts/get.ts",
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun scripts/build.ts && bun dts && bun build --target node --production src/index.ts --outfile=./dist/index.js",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/core": "workspace:*",
		"@betterdiscord.com/injection": "workspace:*"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-env": "^7.29.5",
		"@babel/preset-typescript": "^7.28.5",
		"@types/babel__core": "^7.20.5"
	}
}
