{
	"name": "@betterdiscord.com/injection",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"cli": "bun ../../packages/cli/dist/main.js",
		"get": "bun scripts/get.ts",
		"test": "bun test",
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun dts && bun build --target node --production src/index.ts --outfile=./dist/index.js -e '@electron/asar' -e '@betterdiscord.com/*'",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/core": "workspace:*",
		"@electron/asar": "^3.2.0"
	}
}
