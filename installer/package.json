{
	"name": "betterdiscord-installer",
	"version": "1.3.0",
	"private": true,
	"main": "dist/main/index.js",
	"description": "A simple standalone program which automates the installation, removal and maintenance of BetterDiscord.",
	"license": "MIT",
	"author": "BetterDiscord",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BetterDiscord/Installer.git"
	},
	"type": "module",
	"scripts": {
		"dev": "bun scripts/build.ts && electron dist/main/index.js",
		"build": "bun scripts/build.ts --production",
		"dist": "bun run build && electron-builder -p never",
		"lint": "bun oxlint --fix && bun publint --pack bun"
	},
	"dependencies": {
		"@betterdiscord.com/bd-injection": "workspace:*",
		"@betterdiscord.com/injection": "workspace:*",
		"source-map-support": "^0.5.16",
		"xterm": "^5.3.0",
		"xterm-addon-fit": "^0.8.0",
		"xterm-addon-web-links": "^0.9.0"
	},
	"devDependencies": {
		"bun-plugin-svelte": "^0.0.6",
		"electron": "^42.0.1",
		"electron-builder": "^26.8.1",
		"find-process": "https://github.com/BetterDiscord/find-process",
		"semver": "^7.3.8",
		"svelte": "^5.55.5",
		"svelte-spa-router": "^3.1.0",
		"tree-kill": "^1.2.2"
	},
	"build": {
		"appId": "app.betterdiscord.installer",
		"files": [
			"dist/main/",
			"dist/renderer/"
		],
		"electronVersion": "42.0.1",
		"npmRebuild": false,
		"nodeGypRebuild": false,
		"buildDependenciesFromSource": false,
		"productName": "BetterDiscord",
		"copyright": "Copyright © 2021 BetterDiscord",
		"afterAllArtifactBuild": "scripts/fixmac.js",
		"win": {
			"artifactName": "${productName}-Windows.${ext}",
			"icon": "assets/icon.ico",
			"target": {
				"target": "portable",
				"arch": [
					"ia32"
				]
			}
		},
		"portable": {
			"requestExecutionLevel": "user",
			"useZip": true,
			"splashImage": "assets/images/splash.bmp"
		},
		"mac": {
			"artifactName": "${productName}-Mac.${ext}",
			"icon": "assets/icon.icns",
			"category": "public.app-category.social-networking",
			"target": {
				"target": "zip",
				"arch": [
					"x64"
				]
			}
		},
		"linux": {
			"artifactName": "${productName}-Linux.${ext}",
			"category": "Utility",
			"target": {
				"target": "AppImage",
				"arch": [
					"x64"
				]
			}
		}
	},
	"productName": "BetterDiscord Installer"
}
