{
	"name": "@betterdiscord.com/core",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"type": "./index.d.ts"
		},
		"./patch_asar": {
			"types": "./dist/patchAsar.d.ts",
			"import": "./dist/patchAsar.js"
		},
		"./api": {
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js"
		}
	},
	"scripts": {
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun scripts/build.ts && bun dts && bun build --target node --production src/patchAsar.ts --outfile=./dist/patchAsar.js && bun build --target node --production src/api/index.ts --outfile=./dist/api/index.js",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/find": "workspace:*"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-env": "^7.29.5",
		"@babel/preset-typescript": "^7.28.5",
		"@types/babel__core": "^7.20.5"
	}
}
