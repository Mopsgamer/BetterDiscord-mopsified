{
	"name": "@betterdiscord.com/injection",
	"version": "1.0.0",
	"private": false,
	"files": [
		"dist/"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./fastfile": {
			"types": "./dist/fastfile.d.ts",
			"import": "./dist/fastfile.js"
		}
	},
	"scripts": {
		"test": "bun test",
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun dts && bun build --target node --production src/index.ts --outfile=./dist/index.js -e '@electron/asar' -e '@betterdiscord.com/*' && bun build --target node --production src/fastfile.ts --outfile=./dist/fastfile.js",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/core": "workspace:*",
		"@electron/asar": "^3.2.0"
	}
}
