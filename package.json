{
	"name": "betterdiscord-rewrite",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"extension",
			"installer"
		],
		"catalog": {
			"react": "19.x",
			"electron": "latest"
		}
	},
	"type": "module",
	"scripts": {
		"cli": "bun --bun ./packages/cli/dist/main.js",
		"get": "bun ./packages/injection/scripts/get.ts",
		"ui": "bun ./scripts/ui.ts",
		"lint": "bun oxlint --fix",
		"fmt": "bun oxfmt",
		"dist": "bun tsgo -p . && bun -F '*' dist",
		"dts": "bun tsgo -p . && bun -F '*' dts"
	},
	"dependencies": {
		"original-fs": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "latest",
		"@typescript/native-preview": "latest",
		"electron": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"publint": "latest"
	},
	"engines": {
		"bun": ">=1.3.13"
	}
}
