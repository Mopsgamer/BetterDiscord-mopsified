{
    "name": "betterdiscord-installer",
    "version": "1.3.0",
    "description": "A simple standalone program which automates the installation, removal and maintenance of BetterDiscord.",
    "license": "MIT",
    "author": "BetterDiscord",
    "type": "module",
    "scripts": {
        "dev": "bun electrobun dev",
        "build:renderer": "bun build ./src/renderer/index.js --outdir ./dist/renderer --minify",
        "compile": "bun run build:renderer",
        "lint": "bun oxlint --fix",
        "fmt": "bun oxfmt",
        "dist": "bun run compile && bun electrobun build --bundle"
    },
    "devDependencies": {
        "electrobun": "catalog:installer",
        "find-process": "catalog:installer",
        "focus-visible": "catalog:installer",
        "phin": "catalog:installer",
        "rimraf": "catalog:installer",
        "semver": "catalog:installer",
        "tree-kill": "catalog:installer"
    },
    "electrobun": {
        "main": "src/main/index.js",
        "views": {
            "main": {
                "url": "dist/renderer/index.html"
            }
        },
        "build": {
            "appId": "app.betterdiscord.installer",
            "productName": "BetterDiscord",
            "copyright": "Copyright '©' 2021 BetterDiscord",
            "mac": {
                "icon": "assets/icon.icns",
                "category": "public.app-category.social-networking"
            },
            "win": {
                "icon": "assets/icon.ico"
            }
        }
    }
}