{
	"name": "@betterdiscord.com/cli",
	"version": "1.0.0",
	"private": true,
	"bin": "./dist/main.js",
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"lint": "bun oxlint --fix && bun publint --pack bun",
		"fmt": "bun oxfmt",
		"dist": "bun dts && bun build --target bun --production src/main.ts --outdir=./dist --outfile=./dist/main.js -e '@betterdiscord.com/*'",
		"dts": "bun tsgo -p ."
	},
	"dependencies": {
		"@betterdiscord.com/injection": "workspace:*"
	}
}
