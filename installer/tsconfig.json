{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@betterdiscord.com/injection": ["../packages/injection/src/index.ts"],
			"@betterdiscord.com/bd-injection": ["../packages/bd-injection/src/index.ts"]
		}
	},
	"include": ["src/**/*", "../packages/injection/src/**/*", "../packages/bd-injection/src/**/*"]
}
