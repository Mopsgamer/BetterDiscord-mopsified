{
	"name": "betterdiscord-rewrite",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"extension",
			"installer"
		],
		"catalog": {
			"react": "19.x",
			"electron": "latest"
		}
	},
	"type": "module",
	"scripts": {
		"cli": "bun --elide-lines 0 -F './packages/cli' cli",
		"get": "bun --elide-lines 0 -F './packages/bd-injection' get",
		"gui": "bun --elide-lines 0 -F './installer' dev",
		"lint": "bun oxlint --fix",
		"fmt": "bun oxfmt",
		"dist": "bun tsgo -p . && bun --elide-lines 0 -F '*' dist || echo 'Failed to build distribution, you could remove tsconfig.tsbuildinfo files'",
		"dts": "bun tsgo -p . && bun --elide-lines 0 -F '*' dts",
		"test": "bun test",
		"i18n": "echo 'not implemented, we will write these from scratch probably' && exit 1"
	},
	"dependencies": {
		"original-fs": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "latest",
		"@typescript/native-preview": "latest",
		"bun-plugin-svelte": "latest",
		"electron": "42.x",
		"electron-builder": "26.x",
		"oxfmt": "latest",
		"oxlint": "latest",
		"publint": "latest"
	},
	"engines": {
		"bun": ">=1.3.13"
	}
}
